# Replace the empty values with distinct, locally generated secrets.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_BIND=127.0.0.1
APP_PORT=8084
# Production: true, with an HTTPS reverse proxy in front of this loopback listener.
COOKIE_SECURE=true
RENTAL_OVERDUE_DAILY_RATE=1.50
RENTAL_TIME_ZONE=Europe/London
API_DOCS_ENABLED=false
# Required only when explicitly using compose.dev.yml.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
